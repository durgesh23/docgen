\documentclass[$if(fontsize)$$fontsize$,$endif$$if(papersize)$$papersize$paper,$endif$$if(lang)$$babel-lang$,$endif$$for(classoption)$$classoption$$sep$,$endfor$]{$if(documentclass)$$documentclass$$else$article$endif$}

% Basic packages
\usepackage{amsmath,amssymb}
\usepackage{lmodern}
\usepackage{ifxetex,ifluatex}
\usepackage{fixltx2e}
\usepackage[T1]{fontenc}
\usepackage[utf8]{inputenc}

% Font settings
$if(mainfont)$
\usepackage{fontspec}
\setmainfont{$mainfont$}
$endif$

% Handle figures and captions
\usepackage{graphicx}
\usepackage{caption}
\usepackage{float}
\floatplacement{figure}{H}

% Enhanced table support with text wrapping
\usepackage{array}
\usepackage{tabularx}
\usepackage{longtable}
\usepackage{booktabs}
\usepackage{multirow}
\usepackage{makecell}
\usepackage{colortbl}

% Define custom column types for better text wrapping in tables
\newcolumntype{L}{>{\raggedright\arraybackslash}X} % Left-aligned with wrapping
\newcolumntype{C}{>{\centering\arraybackslash}X}   % Center-aligned with wrapping
\newcolumntype{R}{>{\raggedleft\arraybackslash}X}  % Right-aligned with wrapping
\newcolumntype{P}[1]{>{\raggedright\arraybackslash}p{#1}} % Fixed width, left-aligned with wrapping
\newcolumntype{B}[1]{>{\raggedright\arraybackslash}p{#1}\arraybackslash} % For paragraphs in cells

% Set table properties for text wrapping
\renewcommand{\arraystretch}{1.2}
\setlength{\tabcolsep}{6pt}

% Helper command to set table width
\newcommand{\setTableWidth}[1]{
  \setlength{\tabcolsep}{4pt}
  \renewcommand{\arraystretch}{1.3}
  \setlength{\LTcapwidth}{#1}
}

% Page layout
\usepackage[$if(geometry)$$for(geometry)$$geometry$$sep$,$endfor$$else$margin=1in$endif$]{geometry}

% Header and footer
\usepackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\leftmark}
\fancyhead[R]{\thepage}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0.4pt}

% Hyperlinks
$if(colorlinks)$
\usepackage[colorlinks=true,linkcolor=$linkcolor$,urlcolor=$urlcolor$,citecolor=$citecolor$]{hyperref}
$else$
\usepackage{hyperref}
$endif$

% Code listings
$if(highlighting-macros)$
$highlighting-macros$
$endif$

% Enhanced code block support with proper wrapping
\usepackage{fvextra}
\usepackage{listings}
\lstset{
  basicstyle=\ttfamily\small,
  breaklines=true,
  breakatwhitespace=false,
  columns=flexible,
  frame=single,
  numbers=left,
  numberstyle=\tiny,
  showstringspaces=false,
  postbreak=\mbox{\textcolor{gray}{→}\space},
  breakindent=0pt,
  breakautoindent=true,
  tabsize=4
}

% Redefine verbatim environments to automatically wrap text
\DefineVerbatimEnvironment{Highlighting}{Verbatim}{commandchars=\\\{\},breaklines=true,breakanywhere=true,breaksymbol=,breakanywheresymbolpre=,breakanywheresymbolpost=}

% Inline code format with automatic wrapping
\let\oldtexttt\texttt
\renewcommand{\texttt}[1]{\oldtexttt{\hspace{0pt}#1\hspace{0pt}}}

% Custom header includes
$if(header-includes)$
$header-includes$
$endif$

\begin{document}

$if(titlepage)$
\begin{titlepage}
  \centering
  $if(title)$
  {\Huge \bfseries $title$ \par}
  \vspace{2cm}
  $endif$
  
  $if(author)$
  {\Large $author$ \par}
  \vspace{1cm}
  $endif$
  
  $if(date)$
  {\large $date$ \par}
  $endif$
\end{titlepage}
$else$
  $if(title)$
  \begin{center}
    {\Huge $title$}
  \end{center}
  $endif$

  $if(author)$
  \begin{center}
    {\large $author$}
  \end{center}
  $endif$

  $if(date)$
  \begin{center}
    {\small $date$}
  \end{center}
  $endif$
$endif$

$if(toc)$
\tableofcontents
\newpage
$endif$

% Configure table captions and spacing
\captionsetup[table]{position=top, skip=10pt}
\captionsetup[figure]{position=bottom, skip=10pt}

% Allow tables to break across pages
\AtBeginEnvironment{longtable}{\setTableWidth{0.9\textwidth}}

% Better table handling
\let\oldlongtable\longtable
\let\endoldlongtable\endlongtable
\renewenvironment{longtable}{\setTableWidth{0.9\textwidth}\oldlongtable}{\endoldlongtable}

$body$

\end{document}